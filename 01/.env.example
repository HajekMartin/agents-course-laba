# Core settings. APP_ENV: development | test | production.
APP_ENV=development
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO
# Reserved agent execution mode: demo | live. Does not enable marketplace HTTP access.
MARKETPLACE_MODE=demo

# Health server bind address and port. Local access: http://localhost:8080/health.
APP_HOST=0.0.0.0
APP_PORT=8080

# Bazos: enable only with operator permission. robots.txt is still enforced.
BAZOS_ACCESS_PERMITTED=false
# Sbazar: current robots.txt disallows automated access; this flag never overrides it.
SBAZAR_ACCESS_PERMITTED=false

# Service addresses inside Compose. The offline doctor only validates syntax.
# The gateway_check module performs explicit online diagnostics.
LLM_BASE_URL=http://agentgateway:3001/v1
AGENTGATEWAY_URL=http://agentgateway:3000/mcp
BAZOS_MCP_URL=http://bazos-mcp:8001/mcp
SBAZAR_MCP_URL=http://sbazar-mcp:8002/mcp

# Host-side gateway ports; container listeners stay fixed.
GATEWAY_MCP_PORT=3000
GATEWAY_LLM_PORT=3001
GATEWAY_UI_PORT=3002

# Existing Unsloth Studio on the Mac. Use its actual API port and loaded /v1/models ID.
# No LLM is installed or started by Compose. No cloud fallback is configured.
UNSLOTH_BASE_URL=http://host.docker.internal:8888/v1
UNSLOTH_MODEL=your-loaded-model-id
UNSLOTH_API_KEY=
# Seconds, including the wait for response headers and idle response-body frames.
LLM_TIMEOUT=120

# Omit optional service variables until needed; empty strings are invalid URLs.
# Keep real credentials in an untracked .env file, never in source control.
