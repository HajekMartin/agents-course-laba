# Generate .env using config/create-env.mjs (see README.md), or fill every blank
# mandatory secret with an independently generated random value. Never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=
FINANCE_DB_NAME=finance
FINANCE_DB_USER=finance_app
FINANCE_DB_PASSWORD=

# Mandatory; keep this value for the entire lifetime of n8n and in secure backups.
N8N_ENCRYPTION_KEY=

# Advertised host and host-side port; publication stays on 127.0.0.1.
N8N_HOST=localhost
N8N_PORT=5678
TIMEZONE=Europe/Prague

# Examples only: use the API URL and exact /models ID from your existing Studio.
# These values do not start a model or automatically create n8n credentials.
UNSLOTH_BASE_URL=http://host.docker.internal:8888/v1
UNSLOTH_MODEL=your-model-id
UNSLOTH_API_KEY=
